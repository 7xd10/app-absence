# ===== EuroPresence Configuration =====
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production-min-32-chars

# ===== Database =====
DATABASE_URL=postgresql://europresence:europresence_pass@localhost:5432/europresence_db

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== Email (SMTP) =====
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=EuroPresence <your-email@gmail.com>

# ===== Security =====
HMAC_SECRET=your-hmac-secret-for-qr-codes-change-in-production
QR_ROTATION_SECONDS=10
GEOFENCE_RADIUS_METERS=80
MAX_LOGIN_ATTEMPTS=5
PASSWORD_RESET_EXPIRY_MINUTES=15

# ===== App Settings =====
APP_NAME=EuroPresence
UNIVERSITY_NAME=Université Euro-Méditerranéenne de Fès
FRONTEND_URL=http://localhost:5000
